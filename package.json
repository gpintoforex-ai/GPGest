{
  "name": "gpgest-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm --prefix frontend ci && npm --prefix frontend run build",
    "deploy": "npm ci && npm run build && wrangler deploy",
    "check:deploy": "wrangler deploy --dry-run",
    "test:cloudflare": "node --test scripts/test-cloudflare-worker.mjs"
  },
  "devDependencies": {
    "wrangler": "4.151.0"
  }
}
