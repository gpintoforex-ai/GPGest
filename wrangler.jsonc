{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gpgest",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-14",
  "keep_vars": true,
  "previews": {},
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
